  "runtimePolicy": {
    "safe16x16UpperBody": true,
    "longCoatGeometry": "REJECT_UNLESS_SEPARATELY_PROVEN",
    "nativeSleevesPreferred": true,
    "unsupportedFeature": "FAIL_CLOSED_NO_GENERIC_SUBSTITUTION"
  },
  "familyArchitectures": {
    "SAILOR_TOP": {
      "version": "4.2.0-technical-reference-experiment",
      "rootBody": {"component": "BODY_SAILOR_WOVEN", "role": "woven upper-body shell"},
      "frontCollar": {
        "component": "COLLAR_SAILOR_BROAD",
        "construction": "broad paired collar leaves lying over the upper chest and shoulders around an open V relationship",
        "comparativeWidth": "clearly wider and more dominant than polo or crew grammar",
        "attachment": "high front neckline and both shoulder-neck junctions"
      },
      "sideTransition": {
        "construction": "compact collar-depth mass wrapping from the front shoulder toward the rear flap",
        "attachment": "upper shoulder only",
        "forbidden": ["detached_patch", "long_horizontal_stripe", "arbitrary_diagonal_slash", "side_torso_rail"]
      },
      "rearFlap": {
        "component": "REAR_PANEL_SAILOR_SQUARE",
        "attachment": "high rear neckline across the upper shoulder field",
        "width": "broad shoulder-spanning",
        "depth": "shallow upper-back only",
        "supportedShapes": ["square", "tapered_square", "shallow_trapezoid"],
        "lowerTermination": "clean straight or gently tapered edge",
        "forbidden": ["tiny_central_rectangle", "deep_hanging_panel", "detached_border"]
      },
      "border": {
        "optional": true,
        "construction": "thin controlled inset perimeter following collar and flap",
        "maximumLogicalWeight": 1,
        "forbidden": ["full_garment_cage", "heavy_sticker_outline", "random_fringe"]
      },
      "frontTieOrInsert": {
        "optional": true,
        "attachment": "front V apex",
        "priority": "subordinate_to_collar"
      },
      "directionalRule": "front, side, and back independently reconstruct one wrapped collar/flap component",
      "referenceBasis": "docs/research/SAILOR_TECHNICAL_REFERENCE_STUDY.md"
    }
  },
  "normalizationPolicy": "Construction topology is the family; fit/proportion, opening variants, design intent, material and surface systems are separate axes unless topology genuinely differs at Farmer scale.",
  "migrationContract": "v3_v4_migration_map.json",
  "identityContract": "Each family must define 1-3 mandatory visual anchors that survive projection and final Farmer rendering.",
  "safeTopologyContract": "safe_envelopes.json"
}
