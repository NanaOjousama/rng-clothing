  "componentGraph": {
    "componentFamilies": [
      "BODY",
      "COLLAR",
      "LAPEL",
      "HOOD",
      "SLEEVE",
      "ARMHOLE",
      "OPENING",
      "PLACKET",
      "ZIPPER",
      "BELT",
      "POCKET",
      "YOKE",
      "WAISTBAND",
      "HEM",
      "CUFF",
      "REAR_PANEL",
      "LINING",
      "RIBBING",
      "STORM_FLAP",
      "VENT"
    ],
    "rules": [
      "Components are selected only from family-compatible options.",
      "Every component declares a parent attachment region.",
      "Every component declares which directions can show it.",
      "Wraparound components must maintain continuity across views.",
      "Front-only components must never be copied blindly to the back.",
      "A component may alter silhouette only inside the garment family's safe runtime envelope."
    ]
  },
  "fitProfiles": {
    "principle": "Male/female/unisex are proportion tendencies, not color/style stereotypes.",
    "examples": {
      "MASC_RELAXED": {
        "shoulderScale": "slightly_broader",
        "waistSuppression": "low",
        "bodyLength": "normal_to_long",
        "volume": "relaxed"
      },
      "FEM_FITTED": {
        "shoulderScale": "narrow_to_medium",
        "waistSuppression": "medium",
        "bodyLength": "normal_to_cropped",
        "volume": "fitted"
      },
      "UNISEX_BOXY": {
        "shoulderScale": "medium",
        "waistSuppression": "none",
        "bodyLength": "normal",
        "volume": "boxy"
      }
    }
  },
  "designIntentLayer": {
    "required": true,
    "rule": "Each garment gets one dominant construction idea and at most one strong supporting idea.",
    "examples": {
      "ACADEMIC_CARDIGAN": {
        "dominant": "wide_v_with_clean_inner_layer",
        "supporting": "ribbed_edge",
        "avoid": [
          "heavy_utility_pockets",
          "large_motifs",
          "random_asymmetry"
        ]
      },
      "RELAXED_WEEKEND_CARDIGAN": {
        "dominant": "wide_open_front",
        "supporting": "large_lower_pockets",
        "fit": "boxy_relaxed"
      }
    }
  },
  "semanticFlatRole": {
    "status": "DEBUG_AND_AUTHORING_BRIDGE",
    "notRuntimeGroundTruth": true,
    "uses": [
      "visualize component placement before pixel compilation",
      "compare real-world architecture extraction to structured model",
      "debug whether an artifact originated in architecture or pixel compilation",
      "human review of front/right/back/left consistency"
    ]
  },
  "provenRendererPolicy": {
    "renderer": "V5_HD",
    "frozen": true,
    "rule": "Architecture learning and generator changes happen upstream. Modify the renderer only for verified renderer bugs."
  },
  "reproducibility": {
    "saveForEveryAcceptedGarment": [
      "seed",
      "rarity",
      "family",
      "architectureVersion",
      "designIntent",
      "fitProfile",
      "selectedComponents",
      "componentParameters",
      "material",
      "semanticRegions",
      "paletteStory",
      "rarityPolishProfile",
      "rendererRoute"
    ],
    "sameSeedSameVersionedDataMustReproduceRecipe": true
  },
  "qualityGate": {
    "humanFarmerScaleAuthority": true,
    "hardRejects": [
      "article identity unclear",
      "side view is merely a squeezed front",
      "back blindly copies front-only construction",
      "floating or unattached trim/lines",
      "impossible component attachment",
      "wraparound feature loses continuity",
      "candidate converges structurally with accepted garments",
      "palette is carrying identity instead of architecture",
      "details only work when enlarged"
    ],
    "failurePolicy": "Reroll the design concept or compatible components; do not endlessly polish the same failed concept."
  },
  "legacyDataImported": {
    "schemaVersion": "2.0.0",
    "generator": {
      "pipeline": [
        "1_RARITY_LANE",
