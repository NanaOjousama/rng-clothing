{
  "schemaVersion": "3.0.0",
  "systemName": "RNG Clothing Hybrid Garment Compiler",
  "corePrinciple": "Use real-world/technical-flat study to author and validate permanent versioned garment architecture; use the structured architecture database for normal autonomous generation.",
  "twoModes": {
    "ARCHITECTURE_AUTHORING_MODE": {
      "purpose": "Learn or repair a garment family from real clothing references.",
      "pipeline": [
        "select_garment_family",
        "inspect_real_world_photos_and_technical_flats",
        "extract_physical_construction",
        "map_features_to_neutral_translation_flat",
        "define_component_graph",
        "define_attachment_rules",
        "define_directional_visibility_rules",
        "define_fit_profiles",
        "define_pixel_priority",
        "human_or_validation_review",
        "save_versioned_architecture_definition"
      ],
      "importantRule": "This mode updates architecture knowledge, not the renderer."
    },
    "NORMAL_GENERATION_MODE": {
      "purpose": "Autonomously generate reproducible original clothing without re-reading a photo every roll.",
      "pipeline": [
        "seed",
        "roll_rarity",
        "select_allowed_garment_family",
        "load_versioned_architecture_definition",
        "roll_design_intent",
        "roll_fit_profile",
        "roll_compatible_component_variants",
        "roll_material",
        "build_canonical_garment_model",
        "validate_physical_constraints",
        "project_front_right_back_left",
        "emit_semantic_flat_debug_preview",
        "compile_pixel_grammar",
        "build_semantic_pixel_regions",
        "roll_palette_story",
        "apply_rarity_polish",
        "render_proven_v5_hd",
        "farmer_preview",
        "quality_and_diversity_gate",
        "accept_or_reroll"
      ]
    }
  },
  "rarityArchitectureBudgets": {
    "COMMON": {
      "constructionBudget": 1.0,
      "surfaceBudget": 0.75,
      "guidance": "Simple everyday architecture; polished art is still mandatory."
    },
    "UNCOMMON": {
      "constructionBudget": 1.5,
      "surfaceBudget": 1.0,
      "guidance": "More construction variation, layering, materials, and fit options."
    },
    "RARE": {
      "constructionBudget": 2.0,
      "surfaceBudget": 1.25,
      "guidance": "Premium but restrained; richer proportion, construction, and finishing without spectacle."
    },
    "LEGENDARY": {
      "constructionBudget": 3.0,
      "surfaceBudget": 2.0,
      "guidance": "Signature identity and memorable silhouette/construction. Spectacle only when coherent."
    }
  },
