      "trimAccent.double_trim_lines": "WRAPAROUND_REGION",
      "pattern.contrast_cuff": "WRAPAROUND_REGION",
      "pattern.single_stripe": "WHOLE_HAT",
      "pattern.twin_stripe": "WHOLE_HAT",
      "pattern.plaid_woven": "WHOLE_HAT",
      "pattern.heather": "WHOLE_HAT",
      "microAccent.diagonal_wrap_band": "WRAPAROUND_REGION",
      "microAccent.cuff_patch_small": "LOCALIZED",
      "microAccent.side_bow_small": "LOCALIZED",
      "microAccent.tiny_label_tag": "LOCALIZED"
    },
    "localizedVisibility": {
      "default": "Only render in declared/intended views; absence in other directions is valid.",
      "sideLabels": "Must remain attached to the physical side/edge region and may move between visible side/front/back frames according to actual placement; never duplicate as a screen-space sticker.",
      "frontMotifs": "Front-only is valid unless the motif definition explicitly declares additional visible views."
    },
    "consistencyCheck": "Directional generation/QC must reject recipes where WHOLE_HAT or WRAPAROUND_REGION identity disappears, changes category, or jumps to the wrong semantic region between cardinal views.",
    "directionalConstruction": {
      "method": "edit-cardinal",
      "front": "approved candidate",
      "right": "SF edit from front",
      "back": "SF edit from front",
      "left": "mirror approved right base",
      "localizedPlacementAuthority": "generator",
      "legacyDirectionSet": "research only"
    }
  },
  "aiAssistedVisualPipeline": "generator/data/ai_assisted_visual_pipeline.json",
  "productionPromotionPolicy": {
    "requiredStatus": "PRODUCTION_APPROVED",
    "candidateMechanicalQC": true,
    "directionMechanicalQC": true,
    "humanArtApproval": true,
    "esmWearApproval": true,
    "rule": "Roll planning may happen before art exists; production pool admission may not."
  },
  "rarityRules": {
    "order": [
      "common",
      "uncommon",
      "rare",
      "epic"
    ],
    "common": {
      "description": "Simple everyday beanie. Subtle material/knit variation only; no motif/emblem/localized decoration.",
      "allowedPatterns": [
        "solid",
        "heather"
      ],
      "allowedTrimAccents": [
        "none",
        "band_trim_line"
      ],
      "forced": {
        "motif": "none",
        "carrierStyle": "none",
        "decorationStyle": "none",
        "motifPlacement": "none",
        "microAccent": "none",
        "attachment": "none",
        "hardwareAccent": "none"
      },
      "allowedKnitStructures": [
