    "strongConflictRules": [
      {
        "id": "cable_vs_dense_pattern",
        "when": {
          "knitStructure": "cable"
        },
        "disallow": {
          "pattern": [
            "plaid_woven",
            "simple_jacquard",
            "twist_stripe"
          ]
        },
        "reason": "Cable already owns the surface rhythm."
      },
      {
        "id": "busy_pattern_vs_large_graphic",
        "when": {
          "pattern": [
            "plaid_woven",
            "simple_jacquard",
            "cable_plus_stripe"
          ]
        },
        "disallow": {
          "motif": [
            "flower_cluster_small",
            "badge_small",
            "patch_rect",
            "patch_square",
            "animal_tiny",
            "mushroom_tiny"
          ]
        },
        "reason": "Dense surface pattern and large graphic compete for dominance."
      },
      {
        "id": "double_trim_vs_wrap",
        "when": {
          "trimAccent": "double_trim_lines"
        },
        "disallow": {
          "microAccent": [
            "diagonal_wrap_band"
          ]
        },
        "reason": "Two region treatments compete for the same visual channel."
      },
      {
        "id": "large_pom_vs_large_graphic",
        "when": {
          "attachment": "pom_large"
        },
        "disallow": {
          "motif": [
            "flower_cluster_small",
            "badge_small",
            "patch_rect",
            "patch_square"
          ]
        },
        "reason": "Large pom and large graphic create two dominant focal points."
      },
      {
        "id": "extra_slouch_vs_heavy_top",
        "when": {
          "slouchDepth": "extra"
        },
        "disallow": {
          "attachment": [
            "pom_large"
          ],
          "crownShape": [
            "pouch"
          ],
          "motifPlacement": [
            "crown_front"
          ]
        },
        "reason": "Extra slouch needs a quieter crown/top silhouette."
      },
      {
        "id": "side_bow_needs_quiet_surface",
        "when": {
          "microAccent": "side_bow_small"
        },
        "disallow": {
          "pattern": [
            "plaid_woven",
            "cable_plus_stripe"
          ],
          "knitStructure": [
            "cable",
            "chunky"
          ]
        },
        "reason": "Small bow stays readable only on a quieter surface."
      }
    ],
    "roleRules": {
      "BASE": "Construction/foundation context. Distinctive construction may consume complexity budget, but CONSTRUCTION-channel features do not become PRIMARY/SECONDARY/ACCENT roles.",
      "PRIMARY": "Single strongest non-construction visual identity after impact and channel-priority ordering.",
      "SECONDARY": "Medium/high-impact non-construction feature that supports rather than competes with PRIMARY.",
      "ACCENT": "Low-impact non-construction finishing detail.",
      "rule": "Exactly zero or one PRIMARY. Never promote a second competing focal point; reject by conflict/channel/budget first."
    },
