  },
  "viewConsistencyPolicy": {
    "classes": {
      "WHOLE_HAT": {
        "description": "Design belongs to the overall hat surface/material and must remain semantically consistent in every visible direction.",
        "requiredViews": [
          "front",
          "right",
          "back",
          "left"
        ],
        "rule": "Preserve the same material/pattern identity and region behavior across all cardinal views; directional geometry may differ."
      },
      "WRAPAROUND_REGION": {
        "description": "Design belongs to a continuous semantic region such as the cuff/headband and must continue around that region in every visible direction.",
        "requiredViews": [
          "front",
          "right",
          "back",
          "left"
        ],
        "rule": "If the region is visible in a view, the same design treatment must be present on that same region. Do not let a front band stripe disappear on side/back."
      },
      "LOCALIZED": {
        "description": "Design is a localized motif/emblem/tag/patch and appears only in views where that placement is intended and physically visible.",
        "rule": "Do not replicate localized art into every direction by default. Visibility is controlled by placement and declared views."
      }
    },
    "axisDefaults": {
      "knitStructure": "WHOLE_HAT",
      "pattern": "WHOLE_HAT",
      "trimAccent": "WRAPAROUND_REGION",
      "microAccent": "LOCALIZED",
      "motif": "LOCALIZED",
      "carrierStyle": "LOCALIZED",
      "decorationStyle": "LOCALIZED",
      "attachment": "LOCALIZED",
      "hardwareAccent": "LOCALIZED"
    },
    "overrides": {
