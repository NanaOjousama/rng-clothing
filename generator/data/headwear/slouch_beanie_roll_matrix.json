        "fine_rib",
        "wide_rib",
        "seed",
        "jersey",
        "brushed",
        "fleece_wool"
      ],
      "allowedBandTypes": [
        "none",
        "narrow_cuff",
        "standard_cuff"
      ]
    },
    "uncommon": {
      "description": "Noticeably stronger material/pattern identity such as stripes, contrast cuff, color blocking, or clearer knit patterning; still no motif/emblem.",
      "forced": {
        "motif": "none",
        "carrierStyle": "none",
        "decorationStyle": "none",
        "motifPlacement": "none"
      },
      "allowedMicroAccents": [
        "none",
        "diagonal_wrap_band"
      ],
      "minimumPatterns": [
        "single_stripe",
        "twin_stripe",
        "contrast_cuff",
        "two_tone_block",
        "twist_stripe",
        "simple_jacquard"
      ],
      "distinctiveFeatureRule": {
        "requireAny": {
          "pattern": [
            "single_stripe",
            "twin_stripe",
            "contrast_cuff",
            "two_tone_block",
            "twist_stripe",
            "simple_jacquard"
          ],
          "knitStructure": [
            "waffle",
            "cable",
            "chunky"
          ],
          "bandType": [
            "deep_cuff",
            "rolled_cuff",
            "double_roll"
          ],
          "trimAccent": [
            "band_trim_line",
            "crown_trim_line",
            "double_trim_lines"
          ],
          "microAccent": [
            "diagonal_wrap_band"
          ],
          "attachment": [
            "pom_small",
            "pom_large"
          ],
          "hardwareAccent": [
            "button_accent"
          ]
        }
      }
    },
    "rare": {
      "description": "Motifs/emblems/patches/badges/localized decoration may begin at Rare.",
      "allowsLocalizedDecoration": true
    },
    "epic": {
      "description": "Highest visual complexity; layered strong pattern/material treatment plus Rare-level localized decoration may combine.",
      "allowsLocalizedDecoration": true
    },
    "minimumRarityByFeature": {
      "motif_non_none": "rare",
      "carrierStyle_non_none": "rare",
      "localized_microAccent": [
        "rare",
        "cuff_patch_small",
        "side_bow_small",
        "tiny_label_tag"
      ],
      "single_stripe": "uncommon",
      "twin_stripe": "uncommon",
      "contrast_cuff": "uncommon",
      "two_tone_block": "uncommon",
      "twist_stripe": "uncommon",
      "simple_jacquard": "uncommon",
      "cable_plus_stripe": "rare"
    }
  },
