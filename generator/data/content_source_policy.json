{
  "schema": "rng-clothing-content-source-policy/v1",
  "defaultMode": "Everything",
  "modes": {
    "VanillaOnly": ["VANILLA"],
    "ModAuthorOnly": ["MOD_AUTHOR"],
    "Everything": ["VANILLA", "MOD_AUTHOR", "CONSTRUCTION_PRINTER"]
